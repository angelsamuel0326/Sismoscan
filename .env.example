# Copia a .env (o configura estas variables en tu hosting). Nunca subas .env a git.
APP_ENV=development            # production en despliegue (exige SECRET_KEY y activa cookies seguras)
SECRET_KEY=cambia-esto-por-una-cadena-larga-aleatoria   # python -c "import secrets;print(secrets.token_hex(32))"
# Base de datos: deja DATABASE_URL vacío para usar SQLite local; con PostgreSQL tiene prioridad
DATABASE_PATH=instance/sismoscan.db
DATABASE_URL=                  # postgresql://usuario:clave@host:5432/sismoscan
COOKIE_SECURE=0                # 1 en HTTPS
TRUST_PROXY=0                  # 1 detrás de Render/NGINX
TIMEZONE=America/Bogota
PUBLIC_BASE_URL=               # https://tu-app.onrender.com (para los enlaces compartidos)
STORE_THUMBNAIL=1              # 0 = no guardar ninguna imagen
# IA (opcional). Sin claves: detección local OpenCV + chat por reglas.
VISION_PROVIDER=auto           # auto | openai | google | local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
CHAT_MODEL=                    # por defecto usa OPENAI_MODEL
GOOGLE_VISION_API_KEY=
# Directorio de emergencia (opcional; por defecto 123, 119, 132, 144)
# EMERGENCY_JSON=[["Línea única","123","nota"],["Bomberos","119","nota"]]

# Correo (opcional). Sin SMTP los enlaces de verificación/recuperación solo se registran en el log
# y, fuera de producción, se muestran en pantalla (MOSTRAR_ENLACES_DEMO=1). En producción pon 0 y configura SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MOSTRAR_ENLACES_DEMO=0
REMEMBER_DAYS=30
CONTACT_EMAIL=
SENTRY_DSN=                    # opcional: pip install "sentry-sdk[flask]"
